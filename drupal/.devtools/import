#!/usr/bin/env php
<?php

/**
 * @file
 * Import the authored documentation from its pinned source.
 *
 * `../docs-source.json` names the documentation repository and the commit
 * the site's content is built from. This fetches that commit, runs the IR
 * builder in ../scripts over it, and imports the result into the
 * provisioned site.
 *
 * The content lives in the database, not in the repository, so there is
 * nothing to export and nothing to compare a committed copy against. What
 * this asserts instead is that the site ends up holding a page for every
 * document the source produced.
 *
 * --check refuses to build from anything but the pinned commit, which is
 * what CI wants. Without it, DOCS_CHECKOUT can point the run at a working
 * tree, which is what a developer iterating on the importer wants.
 *
 * DOCS_CHECKOUT points this at a local clone instead of the pinned commit,
 * for iterating on the documentation and the importer together. It is
 * never honoured under --check, because a check that can be pointed at an
 * uncommitted working tree is not checking the pin.
 *
 * DOCS_REPOSITORY replaces the clone URL alone, for a mirror that already
 * holds the pinned commit. The commit stays the pinned one.
 */

declare(strict_types=1);

namespace DocsDevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

$check = in_array('--check', array_slice($argv, 1), TRUE);
$repo_root = dirname(getcwd());
$pin_file = $repo_root . '/docs-source.json';
$source_dir = $repo_root . '/.docs-source';
$ir_dir = $repo_root . '/.docs-ir';

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '          📥 IMPORT            ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

// -----------------------------------------------------------------------------
// The pin.
// -----------------------------------------------------------------------------

TASK('Reading the documentation source pin at %s.', $pin_file);
$pin = read_pin($pin_file);
PASS('Pinned to %s at %s.', $pin['repository'], $pin['ref']);

// -----------------------------------------------------------------------------
// The checkout.
// -----------------------------------------------------------------------------

$from_pin = FALSE;
$checkout = resolve_env_value('DOCS_CHECKOUT', '')[0];
if ($checkout !== '' && $check) {
  FAIL('DOCS_CHECKOUT is set, and --check only ever builds from the pinned commit. Unset it to check the pin, or drop --check to build from the working tree.');
}

if ($checkout !== '') {
  TASK('Using the documentation checkout at %s.', $checkout);
  if (!is_dir($checkout . '/.git') && !is_file($checkout . '/.git')) {
    FAIL('DOCS_CHECKOUT %s is not a git checkout. The IR builder lists the corpus with git, so it needs one.', $checkout);
  }
  $head = git_output($checkout, 'rev-parse HEAD');
  if ($head === $pin['ref']) {
    PASS('The checkout is at the pinned commit.');
  }
  else {
    NOTE('The checkout is at %s, not the pinned %s. The content this produces belongs to the working tree, not the pin.', substr($head, 0, 12), substr($pin['ref'], 0, 12));
  }
}
else {
  $repository = resolve_env_value('DOCS_REPOSITORY', $pin['repository'])[0];
  command_must_exist('git');
  TASK('Fetching the pinned commit into %s.', $source_dir);
  fetch_pinned($source_dir, $repository, $pin['ref']);
  $checkout = $source_dir;
  $from_pin = TRUE;
  PASS('Checked out %s.', $pin['ref']);
}

// -----------------------------------------------------------------------------
// The intermediate representation.
// -----------------------------------------------------------------------------

$builder = $repo_root . '/scripts/build-ir.mjs';
TASK('Building the intermediate representation with %s.', $builder);
if (!is_file($builder)) {
  FAIL('The IR builder is missing: %s.', $builder);
}
command_must_exist('node');
// Checked here because the builder's own failure would name a module, not
// the step that installs it.
$node_modules = $repo_root . '/node_modules';
if (!is_dir($node_modules . '/github-slugger')) {
  FAIL('github-slugger is not installed under %s. Run `npm ci` in %s first.', $node_modules, $repo_root);
}
if (is_dir($ir_dir)) {
  remove_directory($ir_dir);
}
passthru_or_fail(
  sprintf('node %s --source %s --out %s', escapeshellarg($builder), escapeshellarg($checkout), escapeshellarg($ir_dir)),
  'The IR builder failed. Nothing was imported.',
);
$documents = glob($ir_dir . '/*.json') ?: [];
if ($documents === []) {
  FAIL('The IR builder exited 0 but wrote no documents to %s.', $ir_dir);
}
PASS('%d documents written to %s.', count($documents), $ir_dir);

// The import below counts pages against this document count, and both come
// from the build above, so a build that quietly produced fewer documents
// would agree with itself. This compares the documents against the pinned
// checkout's tracked files and against the committed baseline, which are
// two sources the builder does not control. Skipped for DOCS_CHECKOUT,
// where the baseline legitimately describes a different commit.
if ($from_pin) {
  TASK('Checking the documents against the pinned corpus and the baseline.');
  passthru_or_fail(
    sprintf(
      'node %s --corpus --root %s --ir %s --source %s',
      escapeshellarg($repo_root . '/scripts/validate-content.mjs'),
      escapeshellarg($repo_root),
      escapeshellarg($ir_dir),
      escapeshellarg($checkout),
    ),
    'The corpus check failed. Nothing was imported.',
  );
  PASS('The documents match the pinned corpus.');
}
else {
  NOTE('Skipping the corpus check: the baseline describes the pinned commit, not this checkout.');
}

// -----------------------------------------------------------------------------
// The import.
// -----------------------------------------------------------------------------

TASK('Importing into the provisioned site.');
if (!is_file('vendor/bin/drush')) {
  FAIL('vendor/bin/drush is missing. Run .devtools/assemble and .devtools/provision first.');
}
drush('druxt-docs:import %s', [$ir_dir]);
PASS('Imported.');

// -----------------------------------------------------------------------------
// What the site ends up holding.
// -----------------------------------------------------------------------------

// A run that imports nothing exits 0 just as happily as one that imports
// everything, so this counts the result rather than trusting the exit code.
TASK('Counting the documentation pages the site now holds.');
$expression = "echo \\Drupal::entityQuery('node')->accessCheck(FALSE)->condition('type', 'doc_page')->count()->execute();";
$counted = drush('php:eval %s', [$expression]);
if (!preg_match('/(\d+)\s*$/', trim($counted), $matches)) {
  FAIL('Could not read a page count from drush. It answered: %s', trim($counted));
}
$imported = (int) $matches[1];
if ($imported !== count($documents)) {
  FAIL('The source produced %d documents and the site holds %d documentation pages. The import did not write what it read.', count($documents), $imported);
}
PASS('%d documentation pages.', $imported);

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '     📥 IMPORT COMPLETE  ✅   ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Source:    ' . $checkout . PHP_EOL;
echo 'Documents: ' . count($documents) . PHP_EOL;
echo 'Pages:     ' . $imported . PHP_EOL;
echo PHP_EOL;

// -----------------------------------------------------------------------------
// Helpers local to this script.
// -----------------------------------------------------------------------------

/**
 * Read and validate the pin file.
 *
 * @return array{repository: string, ref: string}
 *   The pin.
 */
function read_pin(string $file): array {
  if (!is_file($file)) {
    FAIL('No pin file at %s. It names the documentation repository and commit this content is built from.', $file);
  }
  $raw = (string) file_get_contents($file);
  $pin = json_decode($raw, TRUE);
  if (!is_array($pin)) {
    FAIL('%s is not a JSON object.', $file);
  }
  foreach (['repository', 'ref'] as $key) {
    if (!isset($pin[$key]) || !is_string($pin[$key]) || $pin[$key] === '') {
      FAIL('%s is missing "%s".', $file, $key);
    }
  }
  if (!preg_match('/^[0-9a-f]{40}$/', $pin['ref'])) {
    FAIL('%s pins "%s", which is not a full commit sha. Branch names and tags move; the pin has to name exactly one commit.', $file, $pin['ref']);
  }
  return $pin;
}

/**
 * Check out exactly one commit of a repository, reusing it when present.
 */
function fetch_pinned(string $dir, string $repository, string $ref): void {
  if (is_dir($dir . '/.git')) {
    $head = git_output($dir, 'rev-parse HEAD', FALSE);
    $dirty = git_output($dir, 'status --porcelain', FALSE);
    if ($head === $ref && $dirty === '') {
      NOTE('Already checked out.');
      return;
    }
    remove_directory($dir);
  }
  if (!mkdir($dir, 0777, TRUE) && !is_dir($dir)) {
    FAIL('Unable to create %s.', $dir);
  }
  git_run($dir, 'init -q');
  git_run($dir, sprintf('fetch -q --depth 1 %s %s', escapeshellarg($repository), $ref), sprintf('Could not fetch %s from %s. If the commit lives on a mirror, set DOCS_REPOSITORY to the mirror URL.', $ref, $repository));
  git_run($dir, 'checkout -q FETCH_HEAD');
}

/**
 * Run a git command in a directory, failing on error.
 */
function git_run(string $dir, string $arguments, string $failure = ''): void {
  passthru(sprintf('git -C %s %s', escapeshellarg($dir), $arguments), $exit_code);
  if ($exit_code !== 0) {
    FAIL($failure !== '' ? $failure : sprintf('git %s failed in %s.', $arguments, $dir));
  }
}

/**
 * Capture a git command's trimmed output.
 */
function git_output(string $dir, string $arguments, bool $must_succeed = TRUE): string {
  exec(sprintf('git -C %s %s 2>/dev/null', escapeshellarg($dir), $arguments), $output, $exit_code);
  if ($exit_code !== 0 && $must_succeed) {
    FAIL('git %s failed in %s.', $arguments, $dir);
  }
  return trim(implode(PHP_EOL, $output));
}

/**
 * Delete a directory this script created.
 */
function remove_directory(string $dir): void {
  passthru(sprintf('rm -rf %s', escapeshellarg($dir)), $exit_code);
  if ($exit_code !== 0) {
    FAIL('Unable to remove %s.', $dir);
  }
}
